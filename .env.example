# Publicação desativada por padrão. Mude para false apenas para publicar de verdade.
DRY_RUN=true

# Notion
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=3b1f73c4-d13e-4f4e-b5d8-d6a038e9ec99
NOTION_API_VERSION=2022-06-28
TIMEZONE=America/Sao_Paulo

# Logs e banco de dados
LOG_LEVEL=info
DATA_DIR=./data
DATABASE_PATH=./data/linkedin-monitor.sqlite

# LinkedIn OAuth — criar em https://developer.linkedin.com
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
# Versão da API no formato YYYYMM (ex: 202501)
LINKEDIN_API_VERSION=202501

# Analytics (ativar após aprovação do LinkedIn)
LINKEDIN_ANALYTICS_ENABLED=false

# Porta do servidor OAuth local
API_PORT=3000

# Google Drive — vincular imagens a posts do Notion automaticamente
# Crie uma Service Account no Google Cloud e compartilhe a pasta com o e-mail da conta.
# Guia: docs/GOOGLE_DRIVE_SETUP.md
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./secrets/google-service-account.json
# Pasta de imagens dos posts (drive:link)
GOOGLE_DRIVE_FOLDER_ID=1ORKm_J-9L6xsymIKlaMW2xDQjNOGFOAn
# Pasta de inbox de analytics no Drive (watch:inbox lê arquivos .xlsx aqui)
# Crie uma pasta no Drive, compartilhe com o e-mail da Service Account e cole o ID.
GOOGLE_DRIVE_ANALYTICS_INBOX_FOLDER_ID=

# BrainFrost — geração automática de UTM para posts BrainFrost
BRAINFROST_BASE_URL=https://www.brainfrost.com.br/
BRAINFROST_UTM_CAMPAIGN=brainfrost_beta

# Turso — banco remoto (opcional, deixe em branco se usar Supabase)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supabase — tracking de arquivos Drive já processados no GitHub Actions
# Projeto: folha-diaria (pkeztpegqyvqokuykzom)
SUPABASE_URL=
SUPABASE_ANON_KEY=
